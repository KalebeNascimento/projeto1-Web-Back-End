<%- include('../../partials/header') %>

<div class="page-header">
  <h1>Minhas Habilidades</h1>
  <a href="/aluno" class="btn btn-outline">← Voltar ao Painel</a>
</div>

<% if (success && success.length > 0) { %><div class="alert alert-success"><%= success %></div><% } %>
<% if (error && error.length > 0) { %><div class="alert alert-error"><%= error %></div><% } %>

<% if (disponíveis.length > 0) { %>
  <div class="card form-card mb-2">
    <h3>Adicionar Habilidade</h3>
    <form action="/aluno/habilidades" method="POST" class="form-inline">
      <div class="form-group">
        <label for="habilidade_id">Habilidade</label>
        <select id="habilidade_id" name="habilidade_id" required>
          <option value="">Selecione...</option>
          <% disponíveis.forEach(h => { %>
            <option value="<%= h.id %>"><%= h.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="nivel">Nível (0–10)</label>
        <input type="number" id="nivel" name="nivel" min="0" max="10" value="5" required>
      </div>
      <button type="submit" class="btn btn-primary">Adicionar</button>
    </form>
  </div>
<% } %>

<% if (minhasHabilidades.length === 0) { %>
  <div class="empty-state"><p>Você não possui habilidades registradas.</p></div>
<% } else { %>
  <div class="card">
    <h3>Habilidades Registradas</h3>
    <div class="skills-list">
      <% minhasHabilidades.forEach(h => { %>
        <div class="skill-item">
          <span class="skill-name"><%= h.nome %></span>
          <div class="skill-bar">
            <div class="skill-fill" style="width: <%= h.nivel * 10 %>%"></div>
          </div>
          <span class="skill-level"><%= h.nivel %>/10</span>
          <div class="skill-actions">
            <form action="/aluno/habilidades/<%= h.id %>/editar" method="POST" class="form-inline-small">
              <input type="number" name="nivel" min="0" max="10" value="<%= h.nivel %>" required>
              <button type="submit" class="btn btn-sm btn-outline">Atualizar</button>
            </form>
            <form action="/aluno/habilidades/<%= h.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Remover habilidade?')">
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit" class="btn btn-sm btn-danger">Remover</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
<% } %>

<%- include('../../partials/footer') %>
