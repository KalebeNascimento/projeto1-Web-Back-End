<%- include('../../partials/header') %>

<div class="page-header">
  <h1>Novo Aluno</h1>
  <a href="/admin/alunos" class="btn btn-outline">← Voltar</a>
</div>

<% if (error && error.length > 0) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card form-card">
  <form action="/admin/alunos" method="POST">
    <div class="form-group">
      <label for="nome">Nome completo *</label>
      <input type="text" id="nome" name="nome" required placeholder="Nome do aluno">
    </div>
    <div class="form-group">
      <label for="email">E-mail *</label>
      <input type="email" id="email" name="email" required placeholder="email@exemplo.com">
    </div>
    <div class="form-group">
      <label for="senha">Senha *</label>
      <input type="password" id="senha" name="senha" required placeholder="Mínimo 6 caracteres" minlength="6">
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Cadastrar Aluno</button>
      <a href="/admin/alunos" class="btn btn-outline">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../../partials/footer') %>
