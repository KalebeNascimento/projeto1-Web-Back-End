<%- include('../../partials/header') %>

<div class="page-header">
  <h1>Editar Aluno</h1>
  <a href="/admin/alunos" class="btn btn-outline">← Voltar</a>
</div>

<% if (error && error.length > 0) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card form-card">
  <form action="/admin/alunos/<%= aluno.id %>?_method=PUT" method="POST">
    <input type="hidden" name="_method" value="PUT">
    <div class="form-group">
      <label for="nome">Nome completo *</label>
      <input type="text" id="nome" name="nome" required value="<%= aluno.nome %>">
    </div>
    <div class="form-group">
      <label for="email">E-mail *</label>
      <input type="email" id="email" name="email" required value="<%= aluno.email %>">
    </div>
    <div class="form-group">
      <label for="senha">Nova senha <small>(deixe em branco para manter a atual)</small></label>
      <input type="password" id="senha" name="senha" placeholder="Nova senha (mínimo 6 caracteres)" minlength="6">
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Salvar Alterações</button>
      <a href="/admin/alunos" class="btn btn-outline">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../../partials/footer') %>
