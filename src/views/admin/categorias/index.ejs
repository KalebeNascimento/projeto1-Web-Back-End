<%- include('../../partials/header') %>

<div class="page-header">
  <h1>Gerenciar Categorias</h1>
  <a href="/admin/categorias/nova" class="btn btn-primary">+ Nova Categoria</a>
</div>

<a href="/admin" class="btn btn-outline btn-sm mb-1">← Voltar ao Painel</a>

<% if (success && success.length > 0) { %><div class="alert alert-success"><%= success %></div><% } %>
<% if (error && error.length > 0) { %><div class="alert alert-error"><%= error %></div><% } %>

<% if (categorias.length === 0) { %>
  <div class="empty-state"><p>Nenhuma categoria cadastrada.</p></div>
<% } else { %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th>#</th><th>Nome</th><th>Ações</th></tr>
      </thead>
      <tbody>
        <% categorias.forEach(c => { %>
          <tr>
            <td><%= c.id %></td>
            <td><%= c.nome %></td>
            <td class="actions">
              <a href="/admin/categorias/<%= c.id %>/editar" class="btn btn-sm btn-outline">Editar</a>
              <form action="/admin/categorias/<%= c.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Excluir esta categoria?')">
                <input type="hidden" name="_method" value="DELETE">
                <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../../partials/footer') %>
